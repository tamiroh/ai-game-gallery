---
import GameHeader from '../../components/GameHeader.astro';
---
<!doctype html>
<html lang="en" data-game="city-walk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="A quiet, first-person walk through a detailed city in the late afternoon. No missions. Just the city, and you." />
    <title>City Walk — Take the long way home</title>
  </head>
  <body>
    <GameHeader />
    <city-walk>
      <canvas class="world" tabindex="0" aria-label="3D city. Use WASD to walk and drag or move the mouse to look around." aria-describedby="instructions"></canvas>
      <div class="grain" aria-hidden="true"></div>
      <div class="masthead"><span class="eyebrow">AN UNHURRIED AFTERNOON</span><span class="edition">CITY WALK <span> / </span> 01</span></div>
      <section class="welcome" data-panel>
        <div class="rule"></div>
        <p class="eyebrow">GO NOWHERE. SEE EVERYTHING.</p>
        <h1>Take the<br />long way home<span>.</span></h1>
        <p class="intro">A little sunlight. A street you've never taken.<br />The city is yours to wander.</p>
        <button class="enter" data-start disabled>Preparing the city <span>↗</span></button>
        <p class="controls" id="instructions"><b>W A S D</b> walk &nbsp; <b>MOUSE</b> look<br /><b>SHIFT</b> faster &nbsp; <b>F</b> auto walk &nbsp; <b>ESC</b> pause<br />On touch: left thumb to walk, right side to look.</p>
        <p class="message" data-message role="status"></p>
      </section>
      <div class="location"><span class="location-mark">↗</span><div><strong data-street>Westhaven</strong><span data-location>GOLDEN HOUR · FREE ROAM</span></div></div>
      <div class="tools"><button data-sound aria-pressed="false">Sound off</button><button data-reset>Start over</button><button data-auto aria-pressed="false" hidden>Auto walk</button><button data-pause hidden>Pause</button></div>
      <div class="compass" aria-hidden="true"><span data-heading>N</span><div>◇</div><span data-distance>0 m wandered</span></div>
      <div class="reticle" data-reticle hidden aria-hidden="true"></div>
      <div class="joystick" data-stick aria-label="Drag to walk"><span></span></div>
      <p class="touch-look">DRAG TO LOOK</p>
    </city-walk>
    <script>import './game';</script>
  </body>
</html>
<style>
  html[data-game="city-walk"] { height:100%; background:#172023; color:#fff9ee; font-family:Arial, sans-serif; color-scheme:dark; }
  body { margin:0; height:100%; display:flex; flex-direction:column; overflow:hidden; }
  city-walk { display:block; position:relative; flex:1; min-height:0; overflow:hidden; background:#899ba1; }
  .world { width:100%; height:100%; display:block; touch-action:none; outline:none; }
  .grain { position:absolute; inset:0; pointer-events:none; background:linear-gradient(180deg, #09171e4d, transparent 27%, transparent 66%, #0b161f7a); }
  .masthead { position:absolute; top:32px; left:42px; right:42px; display:flex; justify-content:space-between; pointer-events:none; text-shadow:0 2px 10px #0008; }
  .eyebrow { font-size:10px; letter-spacing:.24em; font-weight:600; }
  .edition { font-size:11px; letter-spacing:.15em; }.edition span { margin:0 14px; opacity:.6; }
  .welcome { position:absolute; top:50%; left:8%; transform:translateY(-50%); width:min(540px, 84%); text-shadow:0 2px 24px #07121c77; }
  .welcome::before { content:''; position:absolute; z-index:-1; inset:-100px -90px; background:radial-gradient(ellipse, #142027aa, #14202700 70%); pointer-events:none; }
  .rule { width:44px; height:2px; background:#e8c89b; margin-bottom:24px; }
  h1 { font-family:Georgia, 'Times New Roman', serif; font-weight:400; font-size:clamp(46px, 6.3vw, 88px); line-height:1.04; letter-spacing:-.055em; margin:24px 0; } h1 span { color:#efc38b; }
  .intro { font-size:14px; line-height:1.9; color:#eee9df; margin-bottom:29px; }
  button { font:inherit; cursor:pointer; } .enter { display:flex; align-items:center; justify-content:space-between; gap:58px; background:#f1e7d6; color:#273033; border:0; border-radius:2px; padding:17px 22px; font-size:12px; font-weight:600; letter-spacing:.05em; box-shadow:0 6px 30px #0002; } .enter span { font-size:19px; }.enter:disabled { opacity:.7; cursor:wait; }
  .controls { font-size:10px; line-height:2.1; color:#e4e5e0b3; margin-top:22px; }.controls b { font-size:9px; color:#f4eee2; letter-spacing:.1em; font-weight:500; }.message { max-width:400px; font-size:12px; line-height:1.6; }
  .location { position:absolute; left:42px; bottom:32px; display:flex; gap:13px; align-items:center; pointer-events:none; text-shadow:0 2px 8px #000a; }.location-mark { border:1px solid #e8e5d87a; padding:8px; font-size:17px; }.location strong { display:block; font-size:12px; font-weight:400; letter-spacing:.06em; }.location div>span { display:block; font-size:8px; letter-spacing:.16em; margin-top:7px; color:#e1e6e0bb; }
  .tools { position:absolute; bottom:32px; right:42px; display:flex; gap:8px; }.tools button { padding:9px 12px; background:#16212466; color:#f4eddf; border:1px solid #ece7dc44; border-radius:2px; font-size:10px; backdrop-filter:blur(12px); }
  .compass { position:absolute; top:90px; right:42px; text-align:center; font-size:10px; color:#fff6e5cf; pointer-events:none; text-shadow:0 2px 6px #0008; }.compass div { font-size:30px; line-height:1.3; }.compass>span:last-child { font-size:8px; letter-spacing:.06em; }
  .reticle { position:absolute; top:50%; left:50%; width:3px; height:3px; border-radius:50%; background:#fff8; pointer-events:none; }
  [hidden] { display:none !important; } button:focus-visible { outline:2px solid #f1cf94; outline-offset:5px; }.joystick,.touch-look { display:none; }
  @media (pointer:coarse) { city-walk:global(.playing) .joystick { display:grid; place-items:center; position:absolute; bottom:100px; left:30px; width:106px; height:106px; border:1px solid #fff6; border-radius:50%; background:#14202733; touch-action:none; }.joystick span { width:40px; height:40px; background:#fff5; border-radius:50%; pointer-events:none; } city-walk:global(.playing) .touch-look { display:block; position:absolute; bottom:140px; right:35px; font-size:9px; letter-spacing:.15em; pointer-events:none; color:#fffa; } }
  @media(max-width:650px) { .masthead { top:22px; left:22px; right:22px; }.masthead>.eyebrow { display:none; }.edition { margin-left:auto; }.location { left:20px; bottom:23px; }.tools { right:20px; bottom:23px; gap:5px; }.tools button { padding:9px; }.compass { right:23px; top:67px; }.welcome { left:8%; } .location div>span { font-size:7px; } city-walk:global(.playing) .location { bottom:66px; }.location-mark { display:none; } }
  @media(max-height:650px) { h1 { font-size:46px; margin:12px 0; }.rule { margin-bottom:12px; }.intro { margin-bottom:15px; }.controls { margin-top:12px; }.welcome { top:48%; }.masthead { top:20px; } }
</style>
