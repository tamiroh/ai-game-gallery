---
import GameHeader from "../../components/GameHeader.astro";
---

<!doctype html>
<html lang="en" data-game="downtown-stroll">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Walk a realistic, living downtown in first person. Traffic, signals, shops and parks, with no missions and no destination."
    />
    <title>Downtown Stroll</title>
  </head>
  <body>
    <GameHeader />
    <downtown-stroll>
      <canvas
        class="world"
        tabindex="-1"
        aria-label="First-person view of a city street. Use W A S D to walk and the mouse to look around."
        aria-describedby="stroll-controls"
      ></canvas>
      <div class="lens" aria-hidden="true"></div>

      <div class="radar" aria-hidden="true">
        <canvas class="minimap"></canvas>
      </div>

      <div class="where" aria-live="polite">
        <strong data-street>Central Ave</strong>
        <span data-district>Financial District</span>
      </div>

      <div class="meta" aria-hidden="true">
        <span data-clock></span>
        <span data-walked>0 m walked</span>
      </div>

      <div class="tools">
        <button type="button" data-sound aria-pressed="true">
          Sound: On
        </button>
        <button type="button" data-quality>
          Graphics: High
        </button>
        <button type="button" data-reset>
          Restart
        </button>
      </div>

      <section class="panel" data-panel>
        <p class="kicker">A walk, not a mission</p>
        <h1 data-panel-title>Downtown Stroll</h1>
        <p class="lede" data-panel-text>
          Building the city…
        </p>
        <div class="bar" aria-hidden="true">
          <div data-progress></div>
        </div>
        <button type="button" class="primary" data-start disabled>
          Loading…
        </button>
        <dl class="controls" id="stroll-controls">
          <div class="key">
            <dt>W A S D</dt>
            <dd>Walk</dd>
          </div>
          <div class="key">
            <dt>Mouse</dt>
            <dd>Look around</dd>
          </div>
          <div class="key">
            <dt>Shift</dt>
            <dd>Hurry</dd>
          </div>
          <div class="key">
            <dt>← → / Q E</dt>
            <dd>Turn</dd>
          </div>
          <div class="key">
            <dt>PgUp / PgDn</dt>
            <dd>Look up / down</dd>
          </div>
          <div class="key">
            <dt>R</dt>
            <dd>Back to start</dd>
          </div>
          <div class="key">
            <dt>Esc</dt>
            <dd>Pause</dd>
          </div>
          <div class="touch-only">
            <dt>Touch</dt>
            <dd>Left stick walks, drag to look</dd>
          </div>
        </dl>
      </section>

      <div class="stick" data-stick aria-hidden="true">
        <span></span>
      </div>
      <p class="visually-hidden" role="status" data-status></p>
    </downtown-stroll>
    <script>
      import "./game";
    </script>
  </body>
</html>
<style>
  html[data-game="downtown-stroll"] {
    height: 100%;
    background: #0e1114;
    color: #f3f1ec;
    color-scheme: dark;
    font-family: "Helvetica Neue", "Segoe UI", system-ui, sans-serif;
  }
  html[data-game="downtown-stroll"] body {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  downtown-stroll {
    position: relative;
    flex: 1;
    min-height: 0;
    display: block;
    overflow: hidden;
    background: #9aa3ad;
    user-select: none;
    -webkit-user-select: none;
  }
  .world {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    outline: none;
  }
  .lens {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 120% 95% at 50% 45%, transparent 58%, rgba(8, 10, 14, 0.38));
  }

  .radar {
    position: absolute;
    left: max(22px, env(safe-area-inset-left));
    bottom: max(22px, env(safe-area-inset-bottom));
    width: 168px;
    height: 168px;
    border-radius: 50%;
    padding: 4px;
    background: rgba(10, 12, 14, 0.55);
    box-shadow:
      0 6px 24px rgba(0, 0, 0, 0.35),
      inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    opacity: 0;
    transition: opacity 0.6s;
    pointer-events: none;
  }
  .minimap {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
  }

  .where {
    position: absolute;
    right: max(26px, env(safe-area-inset-right));
    bottom: max(74px, calc(env(safe-area-inset-bottom) + 52px));
    text-align: right;
    text-shadow:
      0 2px 10px rgba(0, 0, 0, 0.55),
      0 0 2px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.6s;
    pointer-events: none;
  }
  .where strong {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 34px);
    letter-spacing: -0.01em;
  }
  .where span {
    display: block;
    margin-top: 4px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(243, 241, 236, 0.82);
  }

  .meta {
    position: absolute;
    top: 18px;
    right: max(24px, env(safe-area-inset-right));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity 0.6s;
    pointer-events: none;
  }
  .meta [data-clock] {
    font-size: 20px;
    font-weight: 300;
    letter-spacing: 0.04em;
  }

  downtown-stroll:global(.playing) :is(.radar, .where, .meta) {
    opacity: 1;
  }

  .tools {
    position: absolute;
    right: max(22px, env(safe-area-inset-right));
    bottom: max(22px, env(safe-area-inset-bottom));
    display: flex;
    gap: 6px;
  }
  .tools button {
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: #f3f1ec;
    background: rgba(12, 14, 17, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 7px 12px;
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .tools button:hover {
    background: rgba(12, 14, 17, 0.72);
  }

  .panel {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(460px, calc(100% - 32px));
    box-sizing: border-box;
    max-height: calc(100% - 32px);
    overflow: auto;
    padding: 30px 32px 26px;
    background: rgba(14, 16, 19, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }
  .panel[hidden] {
    display: none;
  }
  .kicker {
    margin: 0 0 10px;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #d8c49a;
  }
  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(34px, 5vw, 46px);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .lede {
    margin: 12px 0 18px;
    font-size: 15px;
    line-height: 1.55;
    color: rgba(243, 241, 236, 0.82);
  }
  .bar {
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 18px;
  }
  .bar div {
    height: 100%;
    width: 0;
    background: #d8c49a;
    transition: width 0.3s;
  }
  downtown-stroll:global(.ready) .bar {
    visibility: hidden;
  }
  .primary {
    width: 100%;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #15171a;
    background: #f3efe6;
    border: 0;
    border-radius: 12px;
    padding: 13px 18px;
    cursor: pointer;
  }
  .primary:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .primary:not(:disabled):hover {
    background: #fff;
  }
  button:focus-visible {
    outline: 2px solid #d8c49a;
    outline-offset: 3px;
  }
  .controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 18px;
    margin: 20px 0 0;
    font-size: 12px;
  }
  .controls div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 6px;
  }
  .controls dt {
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #f3f1ec;
  }
  .controls dd {
    margin: 0;
    color: rgba(243, 241, 236, 0.7);
    text-align: right;
  }
  .controls .touch-only {
    display: none;
    grid-column: 1 / -1;
  }

  .stick {
    display: none;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (pointer: coarse) {
    .controls .touch-only {
      display: flex;
    }
    .controls .key {
      display: none;
    }
    downtown-stroll:global(.playing) .stick {
      display: grid;
      place-items: center;
      position: absolute;
      left: max(28px, env(safe-area-inset-left));
      bottom: max(34px, env(safe-area-inset-bottom));
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: rgba(12, 14, 17, 0.28);
      border: 1px solid rgba(255, 255, 255, 0.35);
      touch-action: none;
    }
    .stick span {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.55);
      pointer-events: none;
    }
    .radar {
      top: 16px;
      left: 16px;
      bottom: auto;
      width: 116px;
      height: 116px;
    }
    .meta {
      top: 16px;
      right: 16px;
    }
  }

  @media (max-width: 640px) {
    .where {
      bottom: 64px;
      right: 16px;
    }
    .tools {
      right: 12px;
      bottom: 14px;
      gap: 4px;
    }
    .tools button {
      padding: 6px 9px;
      font-size: 10px;
    }
    .panel {
      padding: 24px 20px 20px;
    }
    .controls {
      grid-template-columns: 1fr;
    }
  }
</style>
