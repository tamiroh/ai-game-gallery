---
import GameHeader from "../../components/GameHeader.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A 3D sumo brawl on a floating arena. Bump rival balls over the edge and survive the waves."
    />
    <title>Bumper Brawl</title>
  </head>
  <body>
    <GameHeader />
    <main>
      <h1>Bumper Brawl</h1>
      <p class="instructions">
        Roll with WASD or the arrow keys, dash with Space, restart with R, toggle sound with M. On touchscreens, drag
        anywhere to steer and tap Dash.
      </p>
      <bumper-brawl>
        <div class="hud">
          <span>
            Wave <strong data-wave>1</strong>
          </span>
          <span>
            Knockouts <strong data-score>0</strong>
          </span>
          <span>
            Best <strong data-best>0</strong>
          </span>
          <button type="button" class="mute" data-mute aria-pressed="false">
            Sound on
          </button>
          <span class="dash">
            Dash
            <span class="meter">
              <span data-dash-meter></span>
            </span>
          </span>
        </div>
        <div class="stage" data-stage>
          <canvas tabindex="0" aria-label="Bumper Brawl arena" aria-describedby="brawl-status">
            This game requires a browser with WebGL support.
          </canvas>
          <p class="banner" data-banner data-visible="false"></p>
          <button type="button" class="dash-button" data-dash>
            Dash
          </button>
          <div class="overlay" data-overlay>
            <h2 data-overlay-title>Last ball rolling wins</h2>
            <p data-overlay-text>
              Ram your rivals off the floating arena before they shove you over the edge. A dash hits three times
              harder, and the arena shrinks every wave.
            </p>
            <button type="button" data-start>
              Start
            </button>
          </div>
        </div>
        <p id="brawl-status" class="status" role="status">
          Press Start or Enter to begin.
        </p>
      </bumper-brawl>
    </main>
  </body>
</html>
<script>
  import "./game";
</script>
<style>
  html {
    background: #0d1128;
    color: #eef1ff;
    color-scheme: dark;
    font-family: system-ui, sans-serif;
  }
  body {
    margin: 0;
  }
  main {
    max-width: 1100px;
    margin: auto;
    padding: 16px 16px 40px;
  }
  h1 {
    margin: 4px 0;
    font-size: clamp(1.6rem, 5vw, 2.4rem);
  }
  .instructions {
    margin: 0 0 14px;
    color: #aab4d8;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  bumper-brawl {
    display: block;
  }
  .hud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: center;
    padding: 10px 16px;
    background: #1b2247;
    border-radius: 14px 14px 0 0;
    font-size: 0.9rem;
    color: #aab4d8;
  }
  .hud strong {
    margin-left: 6px;
    color: #ffd166;
    font-size: 1.2rem;
  }
  .dash {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mute {
    margin-left: auto;
    padding: 4px 12px;
    border: 1px solid #46508a;
    border-radius: 999px;
    background: transparent;
    color: #c9d1f0;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .meter {
    display: block;
    width: 90px;
    height: 8px;
    border-radius: 4px;
    background: #0d1128;
    overflow: hidden;
  }
  .meter span {
    display: block;
    height: 100%;
    background: #ff8a3d;
    transform-origin: left;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - 210px);
    min-height: 320px;
    width: 100%;
    background: #141a3a;
    border-radius: 0 0 14px 14px;
    overflow: hidden;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    outline-offset: -3px;
  }
  .banner {
    position: absolute;
    top: 12%;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-size: clamp(1.6rem, 6vw, 3rem);
    font-weight: 800;
    color: #ffd166;
    text-shadow: 0 3px 0 #0d1128;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 0.25s,
      transform 0.25s;
  }
  .banner[data-visible="true"] {
    opacity: 1;
    transform: scale(1);
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px;
    text-align: center;
    background: radial-gradient(ellipse at center, rgba(10, 6, 30, 0.55), rgba(10, 6, 30, 0.1) 70%);
    text-shadow: 0 2px 12px rgba(10, 6, 30, 0.9);
  }
  .overlay[hidden] {
    display: none;
  }
  .overlay h2 {
    margin: 0;
    font-size: clamp(1.4rem, 5vw, 2.2rem);
  }
  .overlay p {
    margin: 0;
    max-width: 46ch;
    color: #c9d1f0;
    line-height: 1.6;
  }
  button {
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    border: 0;
    border-radius: 10px;
    padding: 12px 28px;
    background: #ffd166;
    color: #1d1a05;
  }
  .dash-button {
    display: none;
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 84px;
    height: 84px;
    padding: 0;
    border-radius: 50%;
    background: rgba(255, 138, 61, 0.85);
    color: #fff;
    touch-action: none;
  }
  @media (pointer: coarse) {
    .dash-button {
      display: block;
    }
  }
  .status {
    margin: 12px 0 0;
    color: #aab4d8;
    font-size: 0.9rem;
  }
  :focus-visible {
    outline: 3px solid #7fd4ff;
    outline-offset: 3px;
  }
</style>
