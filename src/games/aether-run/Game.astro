---
import GameHeader from "../../components/GameHeader.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Pilot a hovercraft through hanging gardens, ancient aqueducts and a sunward observatory. A handcrafted 3D skyway expedition."
    />
    <meta name="theme-color" content="#0b2029" />
    <title>Aether Run — A skyway expedition</title>
  </head>
  <body>
    <GameHeader />
    <main>
      <header class="masthead">
        <a class="wordmark" href="#flight">
          AETHER<span>RUN</span>
          <sup>™</sup>
        </a>
        <p>
          A SKYWAY EXPEDITION<span>27° N / ABOVE THE ORDINARY</span>
        </p>
        <span class="edition">
          VOL. 01 <i></i> SUNWARD
        </span>
      </header>
      <aether-run id="flight">
        <div class="viewport" data-viewport>
          <canvas
            class="world"
            tabindex="0"
            aria-label="3D hovercraft course. A and D to steer, Shift to boost, Space to jump, S to brake, P to pause."
            aria-describedby="flight-controls"
          ></canvas>
          <div class="lens" aria-hidden="true"></div>
          <div class="impact" aria-hidden="true"></div>
          <div class="top-hud">
            <div class="sector">
              <i></i>
              <span data-sector>01 / GARDENS</span>
              <small data-distance>2.7 km to sunward</small>
            </div>
            <div class="time">
              <small>FLIGHT TIME</small>
              <strong data-time>0:00.00</strong>
            </div>
            <div class="score">
              <small>EXPEDITION SCORE</small>
              <strong data-score>00000</strong>
              <span data-combo></span>
            </div>
          </div>
          <div class="route" aria-label="Expedition route">
            <div class="route-line">
              <span data-progress></span>
            </div>
            <span class="route-stop first">
              01 <i>HANGING GARDENS</i>
            </span>
            <span class="route-stop middle">
              02 <i>BROKEN AQUEDUCT</i>
            </span>
            <span class="route-stop last">
              03 <i>SUNWARD OBSERVATORY</i>
            </span>
          </div>
          <div class="sector-banner" data-banner aria-hidden="true">
            <span>SECTOR 01 / 03</span>
            <strong>The Hanging Gardens</strong>
            <small>Follow the light. Find your line.</small>
          </div>
          <p class="toast" data-toast aria-hidden="true"></p>
          <p class="warning" data-warning hidden></p>
          <div class="countdown" data-countdown hidden aria-live="assertive">
            3
          </div>
          <div class="bottom-hud">
            <div class="velocity">
              <strong data-speed>0</strong>
              <span>
                KM/H<small>AE—01 / HOVERCRAFT</small>
              </span>
            </div>
            <div class="ship-status">
              <span class="hull-label">
                HULL INTEGRITY <strong data-hull>● ● ● ● ●</strong>
              </span>
              <div class="energy-label">
                <span>BOOST CAPACITOR</span>
                <span>REGENERATIVE</span>
              </div>
              <div
                class="energy"
                role="progressbar"
                aria-label="Boost energy"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="100"
              >
                <div data-energy></div>
              </div>
            </div>
          </div>
          <div class="touch-controls" aria-label="Touch flight controls">
            <div>
              <button type="button" data-hold="left" aria-label="Steer left">
                ←
              </button>
              <button type="button" data-hold="right" aria-label="Steer right">
                →
              </button>
            </div>
            <div>
              <button type="button" data-hold="brake" class="secondary-touch" aria-label="Brake">
                ↓
              </button>
              <button type="button" data-jump aria-label="Jump">
                JUMP
              </button>
              <button type="button" data-hold="boost" class="boost-control" aria-label="Hold to boost">
                BOOST
              </button>
            </div>
          </div>
          <div class="viewport-tools">
            <button type="button" data-touch-pause aria-label="Pause or resume flight">
              Ⅱ
            </button>
            <button type="button" data-exit-fullscreen aria-label="Exit fullscreen">
              ⤡
            </button>
          </div>
          <section class="panel" data-panel aria-label="Flight briefing">
            <div class="panel-inner">
              <p class="eyebrow" data-panel-kicker>
                AETHER EXPEDITION / AE—01
              </p>
              <h1 data-panel-title>Take the skyway.</h1>
              <p class="lede" data-panel-text>
                A hovercraft. Three forgotten worlds. One luminous line through the clouds.
              </p>
              <div data-briefing>
                <div class="modes" data-modes role="group" aria-label="Flight mode">
                  <button type="button" data-mode="expedition" aria-pressed="true">
                    Expedition <span>THE SCENIC ROUTE</span>
                  </button>
                  <button type="button" data-mode="trial" aria-pressed="false">
                    Time Trial <span>THE PERFECT LINE</span>
                  </button>
                </div>
                <p class="mode-help" data-mode-help>
                  5 hull · automatic gap jumps · learn the route
                </p>
                <ol class="briefing">
                  <li>
                    <span>01</span>
                    <p>
                      <strong>Find your line.</strong> Steer smoothly. Coral stones and moving sentinels damage your
                      hull.
                    </p>
                  </li>
                  <li>
                    <span>02</span>
                    <p>
                      <strong>Chase the light.</strong> Crystal chains multiply your score. Fly through rings to refill
                      your boost.
                    </p>
                  </li>
                  <li>
                    <span>03</span>
                    <p>
                      <strong>Leave the ground.</strong> Jump across broken bridges. Green drones repair your craft.
                    </p>
                  </li>
                </ol>
              </div>
              <div class="results" data-results hidden>
                <div class="rank">
                  <span>FLIGHT RANK</span>
                  <strong data-r-rank>A</strong>
                </div>
                <dl>
                  <div>
                    <dt>Score</dt>
                    <dd data-r-score>0</dd>
                  </div>
                  <div>
                    <dt>Flight time</dt>
                    <dd data-r-time>0:00</dd>
                  </div>
                  <div>
                    <dt>Crystals</dt>
                    <dd data-r-crystals>0</dd>
                  </div>
                  <div>
                    <dt>Gates</dt>
                    <dd data-r-rings>0</dd>
                  </div>
                  <div>
                    <dt>Best chain</dt>
                    <dd data-r-chain>0</dd>
                  </div>
                </dl>
              </div>
              <button class="launch" type="button" data-start>
                Begin expedition <span>↗</span>
              </button>
              <button class="change" type="button" data-change hidden>
                Choose flight mode
              </button>
              <div class="personal-best">
                <span>PERSONAL RECORD</span>
                <strong data-best>Your first flight awaits</strong>
              </div>
            </div>
          </section>
        </div>
        <div class="toolbar">
          <p>
            <i></i> ALL SYSTEMS NOMINAL <span>/ NOTHING BUT SKY AHEAD</span>
          </p>
          <div>
            <button type="button" data-pause disabled>
              Ⅱ Pause
            </button>
            <button type="button" data-sound aria-pressed="true">
              Sound on
            </button>
            <button type="button" data-quality>
              Detail high
            </button>
            <button type="button" data-fullscreen>
              ⛶ Expand
            </button>
            <button type="button" data-restart>
              ↺ Restart
            </button>
          </div>
        </div>
        <p class="sr-only" role="status" data-status>
          Ready for departure.
        </p>
      </aether-run>
      <section class="flight-manual" id="flight-controls" aria-label="Flight controls">
        <div class="manual-title">
          <span>FIELD NOTES / 001</span>
          <h2>
            Light hands.
            <br />A clear horizon.
          </h2>
        </div>
        <div class="manual-controls">
          <div>
            <span>STEER</span>
            <p>
              <kbd>A</kbd>
              <kbd>D</kbd> or <kbd>←</kbd>
              <kbd>→</kbd>
            </p>
          </div>
          <div>
            <span>BOOST</span>
            <p>
              <kbd>Shift</kbd> or <kbd>W</kbd>
            </p>
          </div>
          <div>
            <span>JUMP</span>
            <p>
              <kbd>Space</kbd>
            </p>
          </div>
          <div>
            <span>BRAKE / PAUSE</span>
            <p>
              <kbd>S</kbd> / <kbd>P</kbd>
            </p>
          </div>
          <p class="touch-note">
            On touchscreens, drag the sky to steer or hold the arrow buttons. Hold BOOST to accelerate. Tap JUMP at a
            broken edge.
          </p>
        </div>
        <p class="manual-tip">
          <span>THE PILOT'S NOTE</span>Rings restore energy. A clean crystal chain can be worth more than raw speed.
          Release boost before the corners, and watch the coral jump markers.
          <small>
            Your best score and fastest completed flight are saved on this device, separately for each mode.
          </small>
        </p>
      </section>
      <footer>
        <span>BUILT FOR THE LONG WAY HOME.</span>
        <span>THREE WORLDS. ONE SKY.</span>
        <a href="#flight">BACK TO FLIGHT ↑</a>
      </footer>
    </main>
  </body>
</html>
<script>
  import "./game";
</script>
<style>
  html {
    background: #0b2029;
    color: #e9f1e7;
    font-family: Arial, Helvetica, sans-serif;
    color-scheme: dark;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
  }
  * {
    box-sizing: border-box;
  }
  main {
    max-width: 1560px;
    padding: 0 36px;
    margin: auto;
  }
  .masthead {
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .wordmark {
    font-size: 30px;
    font-weight: 900;
    letter-spacing: -1.7px;
    text-decoration: none;
    color: #f0f3e5;
  }
  .wordmark span {
    color: #a7d7bd;
    margin-left: 3px;
  }
  .wordmark sup {
    font-size: 9px;
    vertical-align: top;
    letter-spacing: 0;
    margin-left: 4px;
  }
  .masthead p {
    font-size: 10px;
    letter-spacing: 2px;
    line-height: 1.8;
    color: #d3dbcc;
  }
  .masthead p span {
    display: block;
    color: #789598;
    font-size: 8px;
    letter-spacing: 1.6px;
  }
  .edition {
    font-size: 9px;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 15px;
    color: #8faaa8;
  }
  i {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #a6e1bc;
  }
  .edition i {
    background: #dbb383;
  }
  aether-run {
    display: block;
    border: 1px solid #456066;
    border-radius: 5px;
    overflow: hidden;
    background: #0e2a33;
    position: relative;
  }
  .viewport {
    position: relative;
    width: 100%;
    height: clamp(590px, 73vh, 920px);
    overflow: hidden;
    isolation: isolate;
    background: #9cbbc4;
  }
  .viewport:fullscreen {
    height: 100dvh;
    width: 100vw;
  }
  canvas.world {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    outline: none;
  }
  .lens {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(#071d2c55, transparent 25%, transparent 60%, #071d2c70);
    box-shadow: inset 0 0 150px #10242b22;
  }
  .impact {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 100px #ff6b4966;
    opacity: 0;
    transition: opacity 0.2s;
  }
  aether-run.damaged .impact {
    opacity: 1;
  }
  .top-hud {
    position: absolute;
    left: 32px;
    right: 32px;
    top: 28px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    pointer-events: none;
    color: #fffdf0;
    text-shadow: 0 1px 10px #17364180;
  }
  .top-hud small {
    display: block;
    font-size: 8px;
    letter-spacing: 2px;
    margin-bottom: 6px;
    color: #f0f1d4;
  }
  .sector {
    font-size: 10px;
    letter-spacing: 2px;
    padding-top: 3px;
  }
  .sector i {
    margin-right: 8px;
  }
  .sector small {
    margin: 9px 0 0 14px;
    letter-spacing: 1px;
    font-size: 9px;
  }
  .time {
    text-align: center;
  }
  .time strong {
    font-weight: 400;
    font-size: 27px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -1px;
  }
  .score {
    text-align: right;
    min-width: 150px;
  }
  .score strong {
    font-size: 27px;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
  }
  .score > span {
    display: block;
    font-size: 10px;
    letter-spacing: 2px;
    color: #bbffdf;
    margin-top: 7px;
    height: 12px;
  }
  .route {
    position: absolute;
    top: 105px;
    left: 32px;
    right: 32px;
    height: 35px;
    pointer-events: none;
  }
  .route-line {
    height: 1px;
    background: #efffe044;
    position: absolute;
    inset: 0 0 auto;
  }
  .route-line span {
    display: block;
    height: 2px;
    background: #ddffd5;
    transform: scaleX(0);
    transform-origin: left;
    box-shadow: 0 0 6px #fff8;
  }
  .route-stop {
    position: absolute;
    top: 10px;
    font-size: 8px;
    letter-spacing: 1px;
    color: #ffffffb0;
  }
  .route-stop:before {
    content: "";
    position: absolute;
    top: -12px;
    left: 0;
    width: 3px;
    height: 3px;
    background: #f0f7d5;
  }
  .route-stop i {
    font-style: normal;
    background: none;
    width: auto;
    height: auto;
    border-radius: 0;
    font-size: 7px;
    margin-left: 7px;
  }
  .route-stop.middle {
    left: 33.333%;
  }
  .route-stop.last {
    left: 66.666%;
  }
  .bottom-hud {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 27px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    pointer-events: none;
  }
  .velocity {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .velocity > strong {
    font-size: 58px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -3px;
    font-variant-numeric: tabular-nums;
  }
  .velocity > span {
    font-size: 10px;
    letter-spacing: 1px;
    padding-top: 8px;
  }
  .velocity small {
    display: block;
    font-size: 7px;
    letter-spacing: 1px;
    margin-top: 7px;
    color: #bfd2cd;
  }
  .ship-status {
    width: 220px;
  }
  .hull-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 8px;
    letter-spacing: 1px;
    margin-bottom: 14px;
  }
  .hull-label strong {
    font-size: 13px;
    letter-spacing: 2px;
    color: #d3f4d2;
  }
  .energy-label {
    font-size: 7px;
    letter-spacing: 1px;
    display: flex;
    justify-content: space-between;
    color: #c2d1c4;
    margin-bottom: 7px;
  }
  .energy-label span:last-child {
    font-size: 6px;
  }
  .energy {
    height: 4px;
    background: #a8d9bf33;
  }
  .energy > div {
    height: 100%;
    background: #bff4d3;
    transform-origin: left;
    box-shadow: 0 0 10px #bff4d333;
  }
  .boosting .energy > div {
    background: #ffe4aa;
  }
  .boosting .velocity > strong {
    color: #ffdfab;
  }
  .panel {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #102c39f2 0%, #102c39df 36%, #102c3966 70%, #102c3922);
    display: flex;
    align-items: center;
    overflow: auto;
    z-index: 4;
  }
  .panel-inner {
    width: 440px;
    max-width: 100%;
    margin: 45px 0 28px 48px;
    padding: 0 12px 0 0;
  }
  .eyebrow {
    font-size: 9px;
    letter-spacing: 2.3px;
    color: #b8d9c3;
    margin: 0 0 16px;
  }
  h1 {
    font-weight: 400;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 4.2vw, 68px);
    line-height: 1.04;
    letter-spacing: -2px;
    margin: 0 0 17px;
    text-wrap: balance;
  }
  .lede {
    font-size: 13px;
    line-height: 1.8;
    max-width: 340px;
    color: #b9cbc9;
    margin: 0 0 24px;
  }
  .modes {
    display: flex;
    border: 1px solid #7a9c9760;
    margin-bottom: 9px;
    border-radius: 3px;
    overflow: hidden;
  }
  .modes button {
    flex: 1;
    background: transparent;
    color: #aac1ba;
    border: 0;
    text-align: left;
    padding: 12px 15px;
    font-weight: 400;
    font-size: 12px;
    border-radius: 0;
  }
  .modes button + button {
    border-left: 1px solid #7a9c9760;
  }
  .modes button[aria-pressed="true"] {
    background: #b5d5b91c;
    color: #eaffdd;
    box-shadow: inset 0 -2px #bfd9ad;
  }
  .modes span {
    display: block;
    font-size: 6px;
    letter-spacing: 1.5px;
    margin-top: 6px;
    opacity: 0.65;
  }
  .mode-help {
    font-size: 9px;
    color: #a1b8b4;
    margin: 0 0 24px;
  }
  .briefing {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .briefing li {
    display: flex;
    gap: 15px;
    align-items: flex-start;
  }
  .briefing li > span {
    font-size: 9px;
    color: #c5d7ae;
    border: 1px solid #9eb8a844;
    border-radius: 50%;
    padding: 7px;
    margin-top: 1px;
  }
  .briefing p {
    font-size: 10px;
    line-height: 1.7;
    color: #a9c0bb;
    margin: 0;
    max-width: 290px;
  }
  .briefing strong {
    color: #e1ebd6;
    font-weight: 400;
  }
  .launch {
    background: #d4e5b9;
    color: #183835;
    width: 100%;
    border: 1px solid #e1f2cb;
    border-radius: 3px;
    padding: 17px 20px;
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.15s;
  }
  .launch:hover {
    background: #eff8d9;
  }
  .personal-best {
    display: flex;
    justify-content: space-between;
    margin-top: 17px;
    gap: 12px;
    align-items: center;
  }
  .personal-best span {
    font-size: 7px;
    letter-spacing: 1.5px;
    color: #8aaba3;
  }
  .personal-best strong {
    font-size: 9px;
    font-weight: 400;
    color: #a4bdb1;
  }
  .change {
    display: block;
    background: none;
    padding: 12px 0 0;
    color: #bdcdbb;
    border: 0;
    font-size: 10px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .results {
    display: flex;
    gap: 25px;
    margin-bottom: 25px;
    border-top: 1px solid #72938755;
    padding-top: 20px;
  }
  .rank {
    width: 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid #a5bc9655;
    padding: 14px 5px;
  }
  .rank span {
    font-size: 7px;
    letter-spacing: 2px;
    color: #b8cdab;
  }
  .rank strong {
    font:
      80px/1.25 Georgia,
      serif;
    color: #e2e5b6;
  }
  .results dl {
    flex: 1;
    margin: 0;
    align-self: center;
  }
  .results dl div {
    display: flex;
    justify-content: space-between;
    margin: 11px 0;
  }
  .results dt {
    font-size: 10px;
    color: #9db6af;
  }
  .results dd {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: #e6e9d9;
  }
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 20px;
    background: #102d36;
    gap: 15px;
  }
  .toolbar > p {
    margin: 0;
    font-size: 7px;
    letter-spacing: 1px;
    color: #a3bcaf;
  }
  .toolbar p > i {
    margin-right: 7px;
    width: 4px;
    height: 4px;
  }
  .toolbar p > span {
    color: #638c8c;
  }
  .toolbar > div {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
  }
  .toolbar button {
    color: #b6cdc2;
    background: none;
    border: 1px solid #63827d55;
    padding: 7px 10px;
    font-size: 9px;
    border-radius: 2px;
  }
  .toolbar button:hover {
    background: #709b7722;
    border-color: #a2bc9877;
  }
  .toolbar button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  button {
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid #efffbc;
    outline-offset: 3px;
  }
  canvas:focus-visible {
    outline: 1px solid #ccebd755;
    outline-offset: -1px;
  }
  .toast {
    position: absolute;
    top: 32%;
    left: 50%;
    transform: translate(-50%, 10px);
    font-size: 10px;
    letter-spacing: 2px;
    text-align: center;
    color: #efffd5;
    text-shadow: 0 2px 8px #123;
    opacity: 0;
    transition:
      transform 0.25s,
      opacity 0.25s;
    pointer-events: none;
